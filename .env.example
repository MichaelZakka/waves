# Copy to .env.local (or set on the server) and fill in.

# Password for the admin dashboard at /admin. Required to enable it.
ADMIN_PASSWORD=admin123

# Long random string used to sign admin sessions, e.g. from `openssl rand -hex 32`.
# Optional: if left empty, one is derived from ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# The site's public address, e.g. https://www.professionalwaves.com. Used by the
# admin's Website health page to check every page. Optional: if empty, the
# address the admin is using is checked instead.
# SITE_URL=

# Where edited content, uploaded images and login settings are stored. Must be a persistent disk
# in production. Defaults to ./storage in the project folder.
# CONTENT_DIR=/var/lib/professional-waves
